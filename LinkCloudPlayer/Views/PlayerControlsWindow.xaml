<Window x:Class="LinkCloudPlayer.Views.PlayerControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Height="700" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" Foreground="White"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Material Design icon paths (Apache 2.0), 24x24 viewbox -->
        <Geometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="IconPause">M6,19H10V5H6V19M14,5V19H18V5H14Z</Geometry>
        <Geometry x:Key="IconReplay">M12,5V1L7,6L12,11V7C15.31,7 18,9.69 18,13C18,16.31 15.31,19 12,19C8.69,19 6,16.31 6,13H4C4,17.42 7.58,21 12,21C16.42,21 20,17.42 20,13C20,8.58 16.42,5 12,5Z</Geometry>
        <Geometry x:Key="IconVolume">M3,9V15H7L12,20V4L7,9H3M16.5,12C16.5,10.23 15.48,8.71 14,7.97V16.02C15.48,15.29 16.5,13.76 16.5,12M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.84 14,18.7V20.77C18,19.86 21,16.28 21,12C21,7.72 18,4.14 14,3.23Z</Geometry>
        <Geometry x:Key="IconVolumeLow">M3,9V15H7L12,20V4L7,9H3M16.5,12C16.5,10.23 15.48,8.71 14,7.97V16.02C15.48,15.29 16.5,13.76 16.5,12Z</Geometry>
        <Geometry x:Key="IconVolumeOff">M12,4L9.91,6.09L12,8.18M4.27,3L3,4.27L7.73,9H3V15H7L12,20V13.27L16.25,17.53C15.58,18.04 14.83,18.46 14,18.7V20.77C15.38,20.45 16.63,19.82 17.68,18.96L19.73,21L21,19.73L12,10.73M19,12C19,12.94 18.8,13.82 18.46,14.64L19.97,16.15C20.62,14.91 21,13.5 21,12C21,7.72 18,4.14 14,3.23V5.29C16.89,6.15 19,8.83 19,12M16.5,12C16.5,10.23 15.5,8.71 14,7.97V10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z</Geometry>
        <Geometry x:Key="IconFullscreen">M5,5H10V7H7V10H5V5M14,5H19V10H17V7H14V5M17,14H19V19H14V17H17V14M10,17V19H5V14H7V17H10Z</Geometry>
        <Geometry x:Key="IconFullscreenExit">M14,14H19V16H16V19H14V14M5,14H10V19H8V16H5V14M8,5H10V10H5V8H8V5M19,8V10H14V5H16V8H19Z</Geometry>
        <Geometry x:Key="IconSubtitles">M20,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4M4,12H8V14H4V12M14,18H4V16H14V18M20,18H16V16H20V18M20,14H10V12H20V14Z</Geometry>
        <Geometry x:Key="IconSpeed">M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z</Geometry>
        <Geometry x:Key="IconBack">M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z</Geometry>

        <SolidColorBrush x:Key="AccentBrush" Color="#E50914" />

        <!-- Icon button: no chrome, grows slightly on hover -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform />
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#01000000">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.18" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.18" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
        </Style>

        <!-- Entry in the speed / audio / subtitle panels -->
        <Style x:Key="OptionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#01000000" Padding="14,8" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- IMPORTANT: this is a layered (AllowsTransparency) window, and Windows
         sends clicks on fully transparent pixels straight through to whatever
         is underneath (the native video surface). Every area that must
         receive mouse input therefore uses a near-invisible #01000000 brush
         instead of Transparent. -->
    <Grid x:Name="Root" Background="#01000000"
          MouseMove="OnRootMouseMove" MouseLeave="OnRootMouseLeave"
          MouseLeftButtonDown="OnVideoAreaMouseDown" MouseWheel="OnVideoAreaMouseWheel">

        <!-- Buffering spinner -->
        <StackPanel x:Name="BufferingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
            <Grid Width="64" Height="64">
                <Ellipse Stroke="#33FFFFFF" StrokeThickness="5" />
                <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M32,2.5 A29.5,29.5 0 0 1 61.5,32" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" />
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <TextBlock x:Name="BufferingText" Margin="0,12,0,0" FontSize="14" Foreground="#CCFFFFFF"
                       HorizontalAlignment="Center" Text="Loading..." />
        </StackPanel>

        <!-- Centre flash shown on play/pause/seek -->
        <Border x:Name="FlashBadge" Width="96" Height="96" CornerRadius="48" Background="#99000000"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="FlashScale" />
            </Border.RenderTransform>
            <Grid>
                <Path x:Name="FlashIcon" Fill="White" Stretch="Uniform" Width="44" Height="44" />
                <TextBlock x:Name="FlashText" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText" Foreground="#f87171" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Everything that auto-hides -->
        <Grid x:Name="Chrome">
            <!-- Top bar: back + title -->
            <Border VerticalAlignment="Top" Height="110" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel VerticalAlignment="Top" Margin="16,14,16,0">
                <Button Style="{StaticResource IconButton}" Click="OnBackClick" ToolTip="Back"
                        DockPanel.Dock="Left">
                    <Path Data="{StaticResource IconBack}" Style="{StaticResource IconPath}" />
                </Button>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
            </DockPanel>

            <!-- Bottom gradient -->
            <Border VerticalAlignment="Bottom" Height="200" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#D9000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel x:Name="BottomBar" VerticalAlignment="Bottom" Margin="24,0,24,14">

                <!-- Seek bar: custom-built so a single click anywhere seeks,
                     and dragging scrubs with live preview. -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="SeekArea" Height="28" Background="#01000000" Cursor="Hand"
                          MouseEnter="OnSeekMouseEnter" MouseLeave="OnSeekMouseLeave"
                          MouseLeftButtonDown="OnSeekMouseDown" MouseMove="OnSeekMouseMove"
                          MouseLeftButtonUp="OnSeekMouseUp" LostMouseCapture="OnSeekLostCapture">
                        <Grid x:Name="SeekTrack" Height="4" VerticalAlignment="Center">
                            <Border Background="#33FFFFFF" CornerRadius="2" />
                            <Border x:Name="SeekBufferedFill" Background="#66FFFFFF" CornerRadius="2"
                                    HorizontalAlignment="Left" Width="0" />
                            <Border x:Name="SeekHoverFill" Background="#40FFFFFF" CornerRadius="2"
                                    HorizontalAlignment="Left" Width="0" Visibility="Collapsed" />
                            <Border x:Name="SeekFill" Background="{StaticResource AccentBrush}" CornerRadius="2"
                                    HorizontalAlignment="Left" Width="0" />
                        </Grid>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SeekThumb" Width="16" Height="16" Fill="{StaticResource AccentBrush}"
                                     Canvas.Top="6" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="SeekThumbScale" ScaleX="0.8" ScaleY="0.8" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Border x:Name="SeekTooltip" Background="#E6202020" CornerRadius="4" Padding="8,4"
                                    Canvas.Top="-30" Visibility="Collapsed">
                                <TextBlock x:Name="SeekTooltipText" FontSize="13" FontWeight="SemiBold" />
                            </Border>
                        </Canvas>
                    </Grid>

                    <TextBlock x:Name="TimeText" Grid.Column="1" Margin="14,0,0,0" FontSize="14"
                               VerticalAlignment="Center" Text="0:00" Cursor="Hand"
                               MouseLeftButtonDown="OnTimeTextClick"
                               ToolTip="Click to toggle remaining / elapsed time" />
                </Grid>

                <!-- Button row -->
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Style="{StaticResource IconButton}" Click="OnPlayPauseClick" ToolTip="Play/Pause (Space)">
                            <Path x:Name="PlayPauseIcon" Data="{StaticResource IconPause}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnSkipBackClick" ToolTip="Back 10s (←)">
                            <Grid>
                                <Path Data="{StaticResource IconReplay}" Style="{StaticResource IconPath}" Width="32" Height="32" />
                                <TextBlock Text="10" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,5,0,0" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnSkipForwardClick" ToolTip="Forward 10s (→)">
                            <Grid>
                                <Path Data="{StaticResource IconReplay}" Style="{StaticResource IconPath}" Width="32" Height="32"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Text="10" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,5,0,0" />
                            </Grid>
                        </Button>

                        <!-- Volume: slider expands while hovering the group -->
                        <StackPanel x:Name="VolumeGroup" Orientation="Horizontal" Background="#01000000"
                                    MouseEnter="OnVolumeGroupEnter" MouseLeave="OnVolumeGroupLeave">
                            <Button Style="{StaticResource IconButton}" Click="OnMuteClick" ToolTip="Mute (M)">
                                <Path x:Name="VolumeIcon" Data="{StaticResource IconVolume}" Style="{StaticResource IconPath}" />
                            </Button>
                            <Grid x:Name="VolumeArea" Width="0" Height="28" Background="#01000000" Cursor="Hand"
                                  ClipToBounds="True" VerticalAlignment="Center"
                                  MouseLeftButtonDown="OnVolumeMouseDown" MouseMove="OnVolumeMouseMove"
                                  MouseLeftButtonUp="OnVolumeMouseUp">
                                <Grid Height="4" Margin="6,0" VerticalAlignment="Center">
                                    <Border Background="#4DFFFFFF" CornerRadius="2" />
                                    <Border x:Name="VolumeFill" Background="White" CornerRadius="2"
                                            HorizontalAlignment="Left" Width="0" />
                                </Grid>
                                <Canvas Margin="6,0" IsHitTestVisible="False">
                                    <Ellipse x:Name="VolumeThumb" Width="12" Height="12" Fill="White" Canvas.Top="8" />
                                </Canvas>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button x:Name="SpeedButton" Style="{StaticResource IconButton}" Click="OnSpeedClick" ToolTip="Playback speed">
                            <Path Data="{StaticResource IconSpeed}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button x:Name="TracksButton" Style="{StaticResource IconButton}" Click="OnTracksClick" ToolTip="Audio &amp; Subtitles">
                            <Path Data="{StaticResource IconSubtitles}" Style="{StaticResource IconPath}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnFullscreenClick" ToolTip="Fullscreen (F)">
                            <Path x:Name="FullscreenIcon" Data="{StaticResource IconFullscreen}" Style="{StaticResource IconPath}" />
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="BarTitleText" FontSize="15" Foreground="#CCFFFFFF" Margin="16,0"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />
                </DockPanel>
            </StackPanel>

            <!-- Speed panel -->
            <Border x:Name="SpeedPanel" Visibility="Collapsed" Background="#F2181818" CornerRadius="6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Playback Speed" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <StackPanel x:Name="SpeedOptions" Orientation="Horizontal" />
                </StackPanel>
            </Border>

            <!-- Audio & subtitles panel -->
            <Border x:Name="TracksPanel" Visibility="Collapsed" Background="#F2181818" CornerRadius="6"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120" Padding="12,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="200" />
                        <ColumnDefinition Width="Auto" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Audio" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,8" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AudioOptions" />
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Subtitles" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,8" />
                        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SubtitleOptions" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
