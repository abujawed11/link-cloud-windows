<UserControl x:Class="LinkCloudPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="Black">
    <!-- All UI (controls, spinner, errors) lives in PlayerControlsWindow,
         an overlay kept on top of this view: anything placed here would be
         hidden behind the native video surface. -->
    <Grid x:Name="Root">
        <vlc:VideoView x:Name="VlcVideoView" />
    </Grid>
</UserControl>
