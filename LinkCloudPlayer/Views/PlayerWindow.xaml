<Window x:Class="LinkCloudPlayer.Views.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="Player" Height="700" Width="1100" MinWidth="480" MinHeight="300"
        Background="Black"
        KeyDown="OnKeyDown">
    <!-- All UI (controls, spinner, errors) lives in PlayerControlsWindow:
         anything placed here would be hidden behind the native video surface. -->
    <Grid x:Name="Root">
        <vlc:VideoView x:Name="VlcVideoView" />
    </Grid>
</Window>
