<UserControl x:Class="LinkCloudPlayer.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#141414" FontFamily="Segoe UI" Foreground="White"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E50914" />
        <Geometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="IconRestart">M12,5V1L7,6L12,11V7C15.31,7 18,9.69 18,13C18,16.31 15.31,19 12,19C8.69,19 6,16.31 6,13H4C4,17.42 7.58,21 12,21C16.42,21 20,17.42 20,13C20,8.58 16.42,5 12,5Z</Geometry>
        <Geometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="IconFilm">M18,4L20,8H17L15,4H13L15,8H12L10,4H8L10,8H7L5,4H4A2,2 0 0,0 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V4H18Z</Geometry>

        <!-- Big white "Play" button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="26,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#996D6D6E" />
        </Style>

        <!-- Small round header icon button -->
        <Style x:Key="NavIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#01000000" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTextButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#01000000" BorderBrush="#66FFFFFF" BorderThickness="1"
                                CornerRadius="4" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#E5E5E5" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <ContextMenu x:Key="CardMenu" Background="#1F1F1F" Foreground="White" BorderBrush="#333">
            <MenuItem Header="Play from beginning" Click="OnMenuPlayFromStart" />
            <MenuItem Header="Remove from Continue Watching" Click="OnMenuRemoveProgress"
                      Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
        </ContextMenu>

        <!-- One poster tile -->
        <DataTemplate x:Key="CardTemplate">
            <Border x:Name="Card" Width="300" Margin="0,0,18,30" Background="#01000000" Cursor="Hand"
                    RenderTransformOrigin="0.5,0.3" MouseLeftButtonUp="OnCardClick"
                    ContextMenu="{StaticResource CardMenu}" ToolTip="{Binding File.OriginalName}">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" />
                </Border.RenderTransform>
                <StackPanel>
                    <Grid Height="169">
                        <!-- Placeholder while there is no thumbnail -->
                        <Border CornerRadius="6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B2B2B" Offset="0" />
                                    <GradientStop Color="#1A1A1A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Path Data="{StaticResource IconFilm}" Fill="#22FFFFFF" Stretch="Uniform"
                                      Width="56" Height="56" />
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#99FFFFFF"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- Thumbnail -->
                        <Border CornerRadius="6">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <!-- Hover shade + play button -->
                        <Border x:Name="HoverShade" CornerRadius="6" Background="#66000000" Opacity="0">
                            <Border Width="54" Height="54" CornerRadius="27" Background="#E6FFFFFF">
                                <Path Data="{StaticResource IconPlay}" Fill="Black" Stretch="Uniform"
                                      Width="22" Height="22" Margin="4,0,0,0" />
                            </Border>
                        </Border>
                        <!-- Duration badge -->
                        <Border Background="#CC000000" CornerRadius="3" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,12">
                            <TextBlock Text="{Binding DurationLabel}" FontSize="12" FontWeight="SemiBold" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DurationLabel}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- Watch progress -->
                        <Grid VerticalAlignment="Bottom" Height="4" Margin="8,0,8,5"
                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressDone}" />
                                <ColumnDefinition Width="{Binding ProgressLeft}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="#80808080" CornerRadius="2" />
                            <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" Margin="2,10,2,3"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding MetaLine}" FontSize="12" Foreground="#8C8C8C" Margin="2,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding RemainingLabel}" FontSize="12" Foreground="#B3B3B3" Margin="2,3,2,0"
                               Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="HoverShade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Hovered tile draws above its neighbours -->
        <Style x:Key="CardContainer" TargetType="ContentPresenter">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Panel.ZIndex" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged">
            <StackPanel>
                <!-- ───────── Hero banner ───────── -->
                <Grid x:Name="Hero" Height="480" Visibility="Collapsed">
                    <Border Background="#1F1F1F" />
                    <Border>
                        <Border.Background>
                            <ImageBrush x:Name="HeroImage" Stretch="UniformToFill" AlignmentY="Top" />
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#E6141414" Offset="0" />
                                <GradientStop Color="#80141414" Offset="0.45" />
                                <GradientStop Color="#00141414" Offset="0.8" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#99000000" Offset="0" />
                                <GradientStop Color="#00141414" Offset="0.3" />
                                <GradientStop Color="#00141414" Offset="0.65" />
                                <GradientStop Color="#FF141414" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="48,0,48,48" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="HeroBadge" Text="CONTINUE WATCHING" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="HeroTitle" FontSize="46" FontWeight="Bold" TextWrapping="Wrap"
                                   LineHeight="52" />
                        <TextBlock x:Name="HeroMeta" FontSize="16" Foreground="#E5E5E5" Margin="0,10,0,0" />
                        <TextBlock x:Name="HeroLanguages" FontSize="14" Foreground="#B3B3B3" Margin="0,6,0,0" />

                        <Grid x:Name="HeroProgress" Margin="0,16,0,0" Width="320" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Height="4" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="HeroProgressDone" Width="0*" />
                                    <ColumnDefinition x:Name="HeroProgressLeft" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" Background="#80808080" CornerRadius="2" />
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2" />
                            </Grid>
                            <TextBlock x:Name="HeroRemaining" Grid.Column="1" FontSize="13" Foreground="#B3B3B3"
                                       Margin="10,0,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button x:Name="HeroPlayButton" Style="{StaticResource PrimaryButton}" Click="OnHeroPlay">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Fill="Black" Stretch="Uniform" Width="20" Height="20" />
                                    <TextBlock x:Name="HeroPlayText" Text="Play" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="HeroRestartButton" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                    Click="OnHeroRestart">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRestart}" Fill="White" Stretch="Uniform" Width="20" Height="20" />
                                    <TextBlock Text="Start Over" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ───────── Sections ───────── -->
                <StackPanel x:Name="Sections" Margin="48,8,30,40">
                    <TextBlock x:Name="StatusText" Foreground="#F87171" FontSize="14" Margin="0,0,0,16"
                               TextWrapping="Wrap" Visibility="Collapsed" />

                    <StackPanel x:Name="ContinueSection" Visibility="Collapsed">
                        <TextBlock Text="Continue Watching" Style="{StaticResource SectionHeader}" />
                        <ItemsControl x:Name="ContinueList" ItemTemplate="{StaticResource CardTemplate}"
                                      ItemsPanel="{StaticResource WrapPanelTemplate}"
                                      ItemContainerStyle="{StaticResource CardContainer}" />
                    </StackPanel>

                    <TextBlock x:Name="LibraryHeader" Text="My Library" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="LibraryList" ItemTemplate="{StaticResource CardTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}"
                                  ItemContainerStyle="{StaticResource CardContainer}" />
                    <TextBlock x:Name="EmptyText" FontSize="15" Foreground="#8C8C8C" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ───────── Top navigation (floats over the hero) ───────── -->
        <Grid VerticalAlignment="Top" Height="68">
            <Border x:Name="NavBackground" Background="#141414" Opacity="0" />
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <DockPanel Margin="48,0,40,0">
                <TextBlock Text="LINK CLOUD" FontSize="26" FontWeight="Black" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#99000000" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="4"
                            Width="260" Height="34" Margin="0,0,16,0">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Fill="#B3FFFFFF" Stretch="Uniform" Width="16" Height="16" />
                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Titles, languages…" Foreground="#80FFFFFF"
                                       FontSize="14" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Foreground="White" CaretBrush="White" FontSize="14" VerticalAlignment="Center"
                                     Margin="6,0,0,0" TextChanged="OnSearchChanged" KeyDown="OnSearchKeyDown" />
                        </Grid>
                    </Border>
                    <Button Style="{StaticResource NavIconButton}" Click="OnRefreshClick" ToolTip="Refresh library"
                            Margin="0,0,10,0">
                        <Path Data="{StaticResource IconRefresh}" Fill="White" Stretch="Uniform" Width="18" Height="18" />
                    </Button>
                    <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource AccentBrush}"
                            Margin="0,0,10,0" ToolTip="{Binding Text, ElementName=UserEmailText}">
                        <TextBlock x:Name="AvatarText" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="UserEmailText" Foreground="#B3B3B3" FontSize="13" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <Button Content="Log out" Style="{StaticResource NavTextButton}" Click="OnLogoutClick" />
                </StackPanel>
                <Border />
            </DockPanel>
        </Grid>

        <!-- ───────── Resume prompt ───────── -->
        <Grid x:Name="ResumeOverlay" Background="#B3000000" Visibility="Collapsed"
              MouseLeftButtonDown="OnResumeOverlayBackgroundClick">
            <Border Width="460" Background="#181818" CornerRadius="8" HorizontalAlignment="Center"
                    VerticalAlignment="Center" MouseLeftButtonDown="OnResumeDialogClick">
                <StackPanel>
                    <Border Height="240" CornerRadius="8,8,0,0">
                        <Border.Background>
                            <ImageBrush x:Name="ResumeImage" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border CornerRadius="8,8,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00181818" Offset="0.4" />
                                    <GradientStop Color="#FF181818" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Border>
                    <StackPanel Margin="28,0,28,26">
                        <TextBlock x:Name="ResumeTitle" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ResumeMeta" FontSize="14" Foreground="#B3B3B3" Margin="0,6,0,20" />
                        <Button Style="{StaticResource PrimaryButton}" Click="OnResumeContinue" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="Black" Stretch="Uniform" Width="18" Height="18" />
                                <TextBlock x:Name="ResumeButtonText" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Click="OnResumeRestart" Margin="0,10,0,0"
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRestart}" Fill="White" Stretch="Uniform" Width="18" Height="18" />
                                <TextBlock Text="Play from beginning" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
